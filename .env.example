# Copia este archivo a .env y cambia los valores. NUNCA subas .env a GitHub.
POSTGRES_DB=ecoroute
POSTGRES_USER=ecoroute
POSTGRES_PASSWORD=cambia-esta-clave
# Para desarrollo local con "npm run dev" (la base corre en Docker):
DATABASE_URL=postgres://ecoroute:cambia-esta-clave@127.0.0.1:5432/ecoroute
# Mínimo 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
JWT_SECRET=
# Ponlo en true cuando sirvas la web por HTTPS (en producción)
COOKIE_SECURE=false
